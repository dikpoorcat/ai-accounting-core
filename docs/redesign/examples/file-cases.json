  "cases": [
    {
      "id": "F01",
      "name": "同一捕获DB及文档集合，发布新集合不混包",
      "given": "在真实合成库产生head8、文档A并完成归档；启动备份在捕获完成后暂停。",
      "steps": [
        "锁内捕获SQLite快照，将current.json和README复制到本任务capture根，持有A的parts/原件路径租约",
        "释放锁后允许真实业务推进到head9并发布文档B，触发正常清理",
        "从已持久BackupPlan恢复复制并验证包"
      ],
      "expect": {
        "package_database_head": 8,
        "package_document_set": "A",
        "live_database_head": 9,
        "live_document_set": "B",
        "mutable_manifest_read_from": "capture",
        "deleted_while_leased_count": 0,
        "mixed_A_B_file_count": 0,
        "package_integrity_verified": true
      }
    },
    {
      "id": "F02",
      "name": "重启先恢复当前捕获引用，后清理来源",
      "given": "备份pending/running捕获A已持久，随后当前业务不再引用A中的某原件；模拟进程终止。",
      "steps": [
        "重启先检查file_task当前严格plan及捕获集，恢复parts/原件引用租约",
        "允许资料清理后继续原捕获集打包"
      ],
      "expect": {
        "old_required_source_deleted_before_lease_restore": false,
        "new_snapshot_silently_substituted": false,
        "same_scope_head": true,
        "current_task_only": true
      }
    },
    {
      "id": "F03",
      "name": "捕获损坏不换头冒充旧备份",
      "given": "F02重启时某必需捕获文件缺失或摘要错误。",
      "steps": [
        "核对原plan并判该当前任务失败",
        "释放其引用后清理临时捕获；保留当前/上一份有效正式包"
      ],
      "expect": {
        "task_state": "failed",
        "old_plan_reported_success": false,
        "existing_verified_backups_replaced": false,
        "replacement_requires_new_explicit_request": true
      }
    },
    {
      "id": "F04",
      "name": "语义相同不因新临时路径重复任务",
      "given": "同database_id/head、结构指纹、文档集合及必要原件/分片内容；两次capture_id/临时位置不同。",
      "expect": {
        "scope_heads_equal": true,
        "pending_running_succeeded_task_reused": true,
        "request_id_change_creates_duplicate": false,
        "database_snapshot_byte_difference_from_derived_tasks_ignored_for_semantic_head": true,
        "unrelated_global_snapshot_head_change_reuses_report": true
      }
    },
    {
      "id": "F05",
      "name": "真正内容或结构变化使计划不同",
      "variants": [
        "结构fingerprint变化",
        "标准document_set_id变化",
        "必要原件内容摘要变化",
        "报告正式snapshot/范围变化",
        "报告variant或template_version变化",
        "报告绑定的organization法定名称/身份变化"
      ],
      "expect": {
        "scope_head_changes": true,
        "old_report_or_backup_not_claimed_as_new": true
      }
    },
    {
      "id": "F06",
