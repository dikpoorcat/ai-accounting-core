{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-accounting.local/design/review-materials.schema.json",
  "title": "独立只读来源查阅合同",
  "$ref": "#/$defs/ReviewMaterialsResponse",
  "$defs": {
    "Head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "ReviewMaterialsQuery": {
      "type": "object",
      "properties": {
        "company_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "business_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "result_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected_version": {
          "$ref": "#/$defs/Head"
        }
      },
      "required": [
        "company_id",
        "business_id"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "result_id": [
          "generation"
        ],
        "generation": [
          "result_id"
        ],
        "cursor": [
          "expected_version"
        ]
      }
    },
    "Selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "current"
            },
            "fact_seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "mode",
            "fact_seq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "frozen"
            },
            "result_id": {
              "$ref": "core.schema.json#/$defs/Id"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "posting_period": {
              "$ref": "core.schema.json#/$defs/Month"
            }
          },
          "required": [
            "mode",
            "result_id",
            "generation",
            "posting_period"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "open_result"
            },
            "result_id": {
              "$ref": "core.schema.json#/$defs/Id"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "posting_period": {
              "$ref": "core.schema.json#/$defs/Month"
            }
          },
          "required": [
            "mode",
            "result_id",
            "generation",
            "posting_period"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SourceItem": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "owner_statement"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "$ref": "core.schema.json#/$defs/Digest"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "archive_month": {
          "anyOf": [
            {
              "$ref": "core.schema.json#/$defs/Month"
            },
            {
              "type": "null"
            }
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "available": {
          "type": "boolean"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "missing_file",
                "content_mismatch"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "kind",
        "label",
        "sha256",
        "byte_size",
        "media_type",
        "archive_month",
        "locations",
        "available",
        "unavailable_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "unavailable_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "unavailable_reason": {
                "type": "string",
                "enum": [
                  "missing_file",
                  "content_mismatch"
                ]
              }
            }
          }
        }
      ]
    },
    "ReviewMaterialsResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "company_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "database_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "business_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "business_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "snapshot_version": {
          "$ref": "#/$defs/Head"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceItem"
          },
          "maxItems": 500
        },
        "page": {
          "$ref": "core.schema.json#/$defs/Page"
        }
      },
      "required": [
        "schema_version",
        "company_id",
        "database_id",
        "business_id",
        "business_label",
        "selection",
        "snapshot_version",
        "sources",
        "page"
      ],
      "additionalProperties": false
    },
    "SourceContentQuery": {
      "type": "object",
      "properties": {
        "company_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "business_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "source_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "result_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_version": {
          "$ref": "#/$defs/Head"
        }
      },
      "required": [
        "company_id",
        "business_id",
        "source_id",
        "expected_version"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "result_id": [
          "generation"
        ],
        "generation": [
          "result_id"
        ]
      }
    },
    "SourceTextContent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "company_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "database_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "source_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "kind": {
          "const": "owner_statement"
        },
        "sha256": {
          "$ref": "core.schema.json#/$defs/Digest"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "schema_version",
        "company_id",
        "database_id",
        "source_id",
        "kind",
        "sha256",
        "text"
      ],
      "additionalProperties": false
    },
    "SourceFileReceipt": {
      "description": "文件二进制响应的测试回执，由响应头规范化取得；不是另一份JSON响应正文。",
      "type": "object",
      "properties": {
        "company_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "database_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "source_id": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "sha256": {
          "$ref": "core.schema.json#/$defs/Digest"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "content_type": {
          "const": "application/octet-stream"
        },
        "disposition": {
          "const": "attachment"
        }
      },
      "required": [
        "company_id",
        "database_id",
        "source_id",
        "sha256",
        "byte_size",
        "file_name",
        "content_type",
        "disposition"
      ],
      "additionalProperties": false
    }
  }
}
