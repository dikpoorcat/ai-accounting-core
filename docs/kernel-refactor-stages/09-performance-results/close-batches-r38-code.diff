+"""Exact close I/O batches retain the single-close content checks."""
+
+import hashlib
+import sqlite3
+
+import pytest
+from test_close_accounting_filter import _close_empty_months, _closed_charge
+from test_engine import engine as engine_fixture
+from test_integrity_content import damage
+
+from ai_accounting.kernel import close_storage
+from ai_accounting.kernel.contracts import KernelError
+
+engine = engine_fixture
+
+
+def _rows(connection):
+    return connection.execute("SELECT * FROM period_close ORDER BY period").fetchall()
+
+
+def test_batched_headers_and_named_readiness_keep_order_and_exact_content(engine):
+    _closed_charge(engine)
+    _close_empty_months(engine, ("2026-02",))
+    with engine.store.connection(read_only=True) as connection:
+        rows = list(reversed(_rows(connection)))
+        headers = close_storage.verified_headers(connection, rows)
+        assert [header.period for header in headers] == [row["period"] for row in rows]
+        assert headers == tuple(close_storage.verified_header(connection, row) for row in rows)
+        assert close_storage.read_readiness_checks_many(
+            connection, headers, "financial_reports"
+        ) == tuple(
+            close_storage.read_readiness_check(connection, header, "financial_reports")
+            for header in headers
+        )
+        assert close_storage.read_readiness_checks_many(
+            connection, headers, "missing_checker"
+        ) == ({}, {})
+
+
+def test_accounting_batch_uses_exact_buckets_and_original_slice_comparisons(engine):
+    _closed_charge(engine)
+    _close_empty_months(engine, ("2026-02", "2026-03"))
+    with engine.store.connection(read_only=True) as connection:
+        rows = _rows(connection)
+        headers = close_storage.verified_headers(connection, rows)
+        serial = tuple(
+            close_storage.read_accounting(connection, header, {"included", "unrelated"})
+            for header in headers
+        )
+        statements = []
+        connection.set_trace_callback(statements.append)
+        try:
+            staged = {}
+            batch = close_storage.read_accounting_many(
+                connection, headers, {"included", "unrelated"},
+                _verified_parts=staged,
+            )
+        finally:
+            connection.set_trace_callback(None)
+        assert batch == serial
+        assert [len(item.adopted_results) for item in batch] == [1, 0, 0]
+        assert sum("CROSS JOIN close_storage_directory d" in sql for sql in statements) <= 2
+        assert sum("CROSS JOIN close_storage_block b" in sql for sql in statements) <= 2
+        assert all(key[0] in {row["period"] for row in rows} for key in staged)
+
