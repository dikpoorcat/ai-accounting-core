+@pytest.mark.parametrize("broken", ["root_missing", "marker_missing", "root_digest"])
+def test_batched_headers_reject_missing_or_damaged_root(engine, broken):
+    first = _closed_charge(engine)
+    _close_empty_months(engine, ("2026-02",))
+    if broken == "root_missing":
+        damage(engine, "close_storage_root", "DELETE FROM close_storage_root WHERE period=?",
+               (first,), foreign_keys=False)
+    elif broken == "marker_missing":
+        damage(engine, "read_index_source",
+               "DELETE FROM read_index_source WHERE source_kind='close' AND source_id=?",
+               (str(first),), foreign_keys=False)
+    else:
+        damage(engine, "close_storage_root",
+               "UPDATE close_storage_root SET storage_digest=? WHERE period=?",
+               (bytes(32), first))
+    with engine.store.connection(read_only=True) as connection:
+        with pytest.raises(KernelError):
+            close_storage.verified_headers(connection, _rows(connection))
+
+
