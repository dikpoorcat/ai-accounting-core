+               "WHERE period=? AND field='adopted_results'", (bytes(32), first))
+    else:
+        damage(engine, "close_storage_block",
+               "INSERT INTO close_storage_block(period,field,bucket,part,content,digest) "
+               "SELECT period,field,bucket,part+10,content,digest FROM close_storage_block "
+               "WHERE period=? AND field='adopted_results'", (first,))
+    with engine.store.connection(read_only=True) as connection:
