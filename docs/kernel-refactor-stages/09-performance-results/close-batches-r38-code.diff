+def _read_stored_bucket_chunks(connection, keys, consume):
+    """Visit exact raw buckets in groups of at most 64, releasing each group."""
+    keys = tuple(dict.fromkeys(keys))
+    for start in range(0, len(keys), 64):
+        chunk = keys[start : start + 64]
+        encoded = canonical(chunk)
+        directories = {
+            (row["period"], row["field"], row["bucket"]): row
+            for row in connection.execute(
+                "SELECT d.period,d.field,d.bucket,d.content,d.digest "
+                "FROM json_each(?) requested CROSS JOIN close_storage_directory d "
+                "ON d.period=json_extract(requested.value,'$[0]') "
+                "AND d.field=json_extract(requested.value,'$[1]') "
+                "AND d.bucket=json_extract(requested.value,'$[2]')",
+                (encoded,),
+            )
