+        blocks = defaultdict(dict)
+        for row in connection.execute(
+            "SELECT b.period,b.field,b.bucket,b.part,b.content,b.digest "
+            "FROM json_each(?) requested CROSS JOIN close_storage_block b "
+            "ON b.period=json_extract(requested.value,'$[0]') "
+            "AND b.field=json_extract(requested.value,'$[1]') "
+            "AND b.bucket=json_extract(requested.value,'$[2]')",
+            (encoded,),
+        ):
+            blocks[row["period"], row["field"], row["bucket"]][row["part"]] = row
+        stored = {
+            key: (directories.get(key), blocks.get(key, {}))
+            for key in chunk
+        }
+        consume(stored)
+        stored.clear()
+        directories.clear()
+        blocks.clear()
