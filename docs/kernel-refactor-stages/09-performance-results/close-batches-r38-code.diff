+               "WHERE period=? AND field='adopted_results'", (first,))
+    elif broken == "directory_digest":
+        damage(engine, "close_storage_directory",
+               "UPDATE close_storage_directory SET digest=? "
+               "WHERE period=? AND field='adopted_results'", (bytes(32), first))
+    elif broken == "block_missing":
+        damage(engine, "close_storage_block",
+               "DELETE FROM close_storage_block "
+               "WHERE period=? AND field='adopted_results'", (first,))
+    elif broken == "block_digest":
