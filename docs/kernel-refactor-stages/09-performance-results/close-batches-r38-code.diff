+def test_raw_batch_is_capped_at_64_exact_buckets():
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    connection.executescript(
+        "CREATE TABLE close_storage_directory(period INTEGER,field TEXT,bucket INTEGER,"
+        "content TEXT,digest BLOB,PRIMARY KEY(period,field,bucket));"
+        "CREATE TABLE close_storage_block(period INTEGER,field TEXT,bucket INTEGER,"
+        "part INTEGER,content TEXT,digest BLOB,PRIMARY KEY(period,field,bucket,part));"
+    )
+    checksum = hashlib.sha256(b"[]").digest()
+    keys = [(month, "adopted_results", 0) for month in range(130)]
+    connection.executemany(
+        "INSERT INTO close_storage_directory VALUES(?,?,?,?,?)",
+        [(month, field, bucket, "[]", checksum) for month, field, bucket in keys],
+    )
+    connection.executemany(
+        "INSERT INTO close_storage_block VALUES(?,?,?,?,?,?)",
+        [(month, field, bucket, 0, "[]", checksum) for month, field, bucket in keys],
+    )
+
+    def probe():
+        steps = [0]
+        chunks = []
+        returned = []
+
+        def progressed():
+            steps[0] += 1
+            return 0
+
+        def consume(chunk):
+            chunks.append(tuple(chunk))
+            for key, (directory, blocks) in chunk.items():
+                returned.append((
+                    key,
+                    None if directory is None else (
+                        directory["content"], bytes(directory["digest"])
+                    ),
+                    tuple(
+                        (part, row["content"], bytes(row["digest"]))
+                        for part, row in sorted(blocks.items())
+                    ),
+                ))
+
+        connection.set_progress_handler(progressed, 1)
+        try:
+            close_storage._read_stored_bucket_chunks(connection, keys, consume)
+        finally:
+            connection.set_progress_handler(None, 0)
+        rows = sum((item[1] is not None) + len(item[2]) for item in returned)
+        value_bytes = sum(
+            (len(item[1][0].encode()) + len(item[1][1]) if item[1] else 0)
+            + sum(len(body.encode()) + len(digest) for _, body, digest in item[2])
+            for item in returned
+        )
+        return steps[0], chunks, returned, rows, value_bytes
+
+    baseline = probe()
+    unrelated = [
+        (500 + index, "vouchers" if index % 2 else "adopted_results",
+         1 if index % 2 else 2, "[]", checksum)
+        for index in range(5000)
+    ]
+    connection.executemany(
+        "INSERT INTO close_storage_directory VALUES(?,?,?,?,?)", unrelated
+    )
+    connection.executemany(
+        "INSERT INTO close_storage_block VALUES(?,?,?,?,?,?)",
+        [(period, field, bucket, 0, content, digest)
+         for period, field, bucket, content, digest in unrelated],
+    )
+    try:
+        noisy = probe()
+    finally:
+        connection.close()
+    assert baseline[1] == noisy[1]
+    assert list(map(len, noisy[1])) == [64, 64, 2]
+    assert set().union(*(set(chunk) for chunk in noisy[1])) == set(keys)
+    assert noisy[2:] == baseline[2:]
+    assert noisy[3] == 260
+    assert noisy[4] == 260 * (2 + len(checksum))
+    assert noisy[0] <= baseline[0] * 1.25 + 1000
