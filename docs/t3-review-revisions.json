  "scope": "仅关闭架构首次验收退回的六项 P2；不扩展 T4/T5 范围",
  "fixes": [
    {
      "id": 1,
      "change": "冻结清单中的同业务无分录多候选标为 unestablished 并保留精确追溯；不进入有效事件或清偿累计。当前清偿独立采用当前头。",
      "test": "test_closed_ambiguous_no_entry_states_are_trace_only",
      "files": [
        "src/ai_accounting/kernel/business_queries.py",
        "tests/kernel/test_business_queries.py"
      ]
    },
    {
      "id": 2,
      "change": "期间当前清偿跟进按截止期业务范围建立种子，纳入精确关联的后来发布与清偿，保留独立 current_cutoff_period；历史 business_status 截止不变。",
      "test": "test_closed_period_current_followups_include_only_related_later_settlement",
      "files": [
        "src/ai_accounting/kernel/business_queries.py",
        "tests/kernel/test_business_queries.py"
      ]
    },
    {
      "id": 3,
      "change": "前期未关账时仍收集当前资料、未发布和领域缺项；仅关账顺序阻断保留 earlier_period_open。正式关闭入口不变。",
      "files": [
        "src/ai_accounting/kernel/workflow.py",
        "tests/kernel/test_period_readiness.py"
      ]
    },
    {
      "id": 4,
      "change": "报表默认筛选保留任何金额列为 null 的行，未知显示为破折号；已知零值普通行仍可隐藏。测试执行实际组件筛选。",
      "files": [
        "frontend/src/views/ReportsView.vue",
        "frontend/tests/reports-adapter.test.mjs"
      ]
    },
    {
      "id": 5,
      "change": "文件任务按明确计划合同验证集合及来源字段；损坏按任务局部返回问题或跳过，不污染其他任务，不将无效来源声明为精确直接关联。",
      "test": "test_malformed_job_collections_are_isolated_to_the_associated_job",
      "files": [
        "src/ai_accounting/kernel/business_queries.py",
        "tests/kernel/test_business_queries.py"
      ]
    },
    {
      "id": 6,
      "change": "承接来源逐项交叉核对事实、冻结金额/义务、精确计算/事实及凭证行；错误声明原样保留并标为 unresolved，沿用备用金可省 source_fact_id 合同。",
      "files": [
        "src/ai_accounting/kernel/query_semantics.py",
        "tests/kernel/test_query_semantics.py"
      ]
    }
  ],
