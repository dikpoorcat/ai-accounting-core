{
  "name": "ai-accounting-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "contracts:generate": "node scripts/generate-dashboard-contracts.mjs",
    "contracts:check": "node scripts/generate-dashboard-contracts.mjs --check",
    "contracts:samples": "node scripts/check-contract-samples.mjs",
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "build": "npm run contracts:check && npm run type-check && vite build",
    "build:release": "npm run contracts:check && npm run type-check && vite build --mode release"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
