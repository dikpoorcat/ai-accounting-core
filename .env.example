# Local development only. Never use these credentials in production.
FINANCE_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
# After running the one-time multi-company migration, DATABASE_URL points to
# finance_catalog and this same-cluster URL is used as the company template.
# FINANCE_COMPANY_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
# FINANCE_PROVISIONING_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/postgres
FINANCE_STORAGE_DIR=./data
FINANCE_EVIDENCE_DIR=./data/evidence
FINANCE_EVIDENCE_IMPORT_DIR=./data/incoming/evidence
FINANCE_BANK_IMPORT_DIR=./data/incoming/bank
FINANCE_MAX_EVIDENCE_BYTES=20971520
FINANCE_MAX_BANK_IMPORT_BYTES=20971520
